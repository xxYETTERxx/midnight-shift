; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Midnight Shift"
run/main_scene="res://scenes/world.tscn"
config/features=PackedStringArray("4.2", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

SaveSystem="*res://scripts/systems/save_system.gd"
ItemRegistry="*res://scripts/systems/item_registry.gd"
WorldStateSystem="*res://scripts/systems/world_state_system.gd"
TimeSystem="*res://scripts/systems/time_system.gd"
RoomManager="*res://scripts/systems/room_manager.gd"
InteractionManager="*res://scripts/systems/interaction_manager.gd"
PlacementSystem="*res://scripts/systems/placement_system.gd"
ScreenFade="*res://scripts/systems/screen_fade.tscn"
TimeSkipSystem="*res://scripts/systems/time_skip_system.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/stretch/mode="viewport"

[dotnet]

project/assembly_name="Midnight Shift"

