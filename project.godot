; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Midnight Shift"
run/main_scene="res://scenes/world.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
run/max_fps=60
config/icon="res://icon.svg"

[autoload]

SaveSystem="*res://scripts/systems/save_system.gd"
NotificationSystem="*res://scripts/systems/notification_system.gd"
Wallet="*res://scripts/systems/wallet.gd"
RentSystem="*res://scripts/systems/rent_system.gd"
ItemRegistry="*res://scripts/systems/item_registry.gd"
TimeSystem="*res://scripts/systems/time_system.gd"
RelationshipSystem="*res://scripts/systems/relationship_system.gd"
ScheduleDatabase="*uid://dafdt3pjdj0cc"
RoomManager="*res://scripts/systems/room_manager.gd"
InteractionManager="*res://scripts/systems/interaction_manager.gd"
PlacementSystem="*res://scripts/systems/placement_system.gd"
ScreenFade="*res://scripts/systems/screen_fade.tscn"
TimeSkipSystem="*res://scripts/systems/time_skip_system.gd"
WorldStateSystem="*res://scripts/systems/world_state_system.gd"
DialogueDatabase="*res://scripts/systems/dialogue_database.gd"
DialogueRuntime="*res://scripts/systems/dialogue_runtime.gd"
DealerExperience="*res://scripts/dealing/dealer_experience.gd"
CustomerRoster="*res://scripts/dealing/customer_roster.gd"
PagerSystem="*res://scripts/dealing/pager_system.gd"
MeetingManager="*res://scripts/dealing/meeting_manager.gd"
MeetingSpawner="*res://scripts/dealing/meeting_spawner.gd"
CriminalExperience="*res://scenes/player/criminal_experience.gd"
CarSpawner="*res://scripts/systems/car_spawner.gd"
PlayerSkills="*res://scripts/systems/player_skills.gd"
CallingCardSystem="*res://scripts/systems/calling_card_system.gd"
NPCDirector="*uid://dy6jg22jcylxc"
EventDirector="*uid://udnxymtxno83"
GiftSystem="*uid://dv0ajswgssafv"
CrimeSystem="*uid://dvtupdj8np4f7"
HeatSystem="*uid://npss3n08k23q"
PoliceSystem="*uid://dlku8cu5weusc"
WitnessRegistry="*uid://cbacx76rfy1ov"
NPCGenerator="*uid://cfwqtkm6kkv5s"
TransitSpawner="*uid://c34laa6kvkory"
DebtSystem="*uid://c5kldrsxmas80"
StreetDealSession="*uid://d02xiioffqljb"
SpotHeatTracker="*uid://f7enji3e2q2r"
HungerSystem="*uid://32gy5gbu88vn"
ThirstSystem="*uid://b38qyr2ng1r4f"
StaminaSystem="*uid://dtrkpkjf6uhm5"
CollapseSystem="*uid://oynxsie731h5"
LotterySystem="*uid://beywniuoc4n20"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[dotnet]

project/assembly_name="Midnight Shift"

