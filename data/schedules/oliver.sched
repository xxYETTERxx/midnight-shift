# oliver.sched — Oliver runs the hardware store on weekdays.

# Default weekday plan: home → store → break → store → home
default
	08:55 transit ext_central home_door->store_door
	09:00 stand hardware_store counter south
	14:55 transit ext_central store_door->oliver_break
	15:00 stand ext_central oliver_break east
	15:55 transit ext_central oliver_break->store_door
	16:00 stand hardware_store counter south
	20:55 transit ext_central store_door->home_door
	21:00 stand oliver_house living_room north

# Sundays — store closed, stays home
sun
	09:00 stand oliver_house living_room east

# After the bodega incident — he's worried, opens late, no break out front
default | event_done bodega_intro
	10:55 transit ext_central home_door->store_door
	11:00 stand hardware_store counter south
	19:55 transit ext_central store_door->home_door
	20:00 stand oliver_house living_room north