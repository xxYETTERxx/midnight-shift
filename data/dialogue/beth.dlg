# Beth.dlg

# --- Default fallback (lowest priority — fires only when nothing else matches)

default
    $n Hey you new in town? Need a drink?
	
has_pager | !has_job
	$n You looking for work kid?
	$b
	$w I could really use the help
	$q
	--> "Maybe, What's the job?"
		$h I need someone to serve drinks 3 nights a week, $40 a shift plus tips. You want it?
		$q
		--> "Sure when do I start?" |set global:has_job
				$h I'll page you with your next shift, see you then!
				$b
				$n Don't be late
		--> "Nope, not for me"
				$s Too bad. Let me know if you change you're mind
		$r
	--> "Nah, I'm good"
		$s Too bad. Let me know if you change you're mind
	$r
	
has_job
	$w Everything alright?
	$q
	--> "Yeah, it's going great!"
		$h Oh good, I'm glad to hear it
	--> "No, I'm sorry I have to quit" |clear global:has_job
		$s That's really too bad
		$b
		$h let me know if you change you're mind
	$r
	
# ============================================================
#  .dlg QUICK REFERENCE   (everything after # is a comment)
# ============================================================
#
# ENTRY KEYS (one block each; pick the matching entry by tags)
#   default            # fallback when nothing else matches (lowest priority)
#   *                  # matches always (priority 0)
#   mon.bodega         # tags joined by '.' — needs BOTH 'mon' AND 'bodega' in context
#   event:intro_scene  # an event block, run by the event director
#
# ENTRY PRECONDITIONS  (after a '|', separated by ';' — ALL must pass)
#   mon.bodega | has_pager ; !has_job          # flag set ; flag NOT set
#   * | trust >= 50                            # compare a stat (ops: >= <= == != > <)
#   * | event_done met_hank ; has_item slim_jim
#
# BODY (indented under the key; tabs or spaces, must be deeper than key)
#   $h Hey there.          # $<code> = portrait/speaker code, rest = text
#   And welcome.           # continuation line (appends to previous text)
#   $b                     # page break (next text is a new box)
#
# QUESTIONS / CHOICES
#   $q                                         # start a choice block
#     --> "Sure thing." | set global:has_job   # response | clauses
#     --> "Not now." | trust < 20              # response shown only if clause passes
#       $h Suit yourself.                      # indented = follow-up after picking
#   $r                                         # END the question block (required!)
#
# RESPONSE CLAUSES  (after '|', ';'-separated — preconditions AND effects mix freely)
#   EFFECTS:   set NAME      # set flag true   (NPC-local unless 'global:' prefix)
#              clear NAME     # set flag false
#              set global:has_job   # GLOBAL flag (autoloads listen to these!)
#              trust +5       # stat delta (trust / affinity), +N or -N
#              affinity -2
#   PRECONDS:  same forms as entry preconditions (flags, compare, has_item, event_done)
# ============================================================