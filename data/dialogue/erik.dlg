# Erik.dlg

# --- Default fallback (lowest priority — fires only when nothing else matches)

default
    $n sup

# --- Bare weekday keys (specificity 1)

mon
    $n You got a smoke man?

wed
    $h I got so fucked up last night man
	$b
	$w I don't feel so well

fri
    $s You holding man?
	
#event:greeting

no_money
	$w Hey man, you got any change?
	$q
	--> "(Ignore him)" | affinity -1
		$a whatever
	--> "Here's a few bucks" | cash -3; affinity +3 ; clear no_money
		$h Awesome thanks man! You new in town? I know where you can get some work 
		$n Have you met Hank?
			$q
			--> "Hank?"
				$h He lives just past the camp. If you need to make some cash, he might be abled to help
			--> "Yeah"
				$n Don't let him scare ya, he's all talk
			$r
		See you around man
		
deal_tut | has_item weed_buds
	$h Whoa! That's some stanky ass bud. Hank hooked you up, didnt he?
	$b
	$n You know how to flip that?
	$q
	--> "not really... did you want to buy some?" | clear deal_tut
		$laugh You think I've got money??
		$b
		$n You just got to find yourself a good spot in town like an alleyway or by the school or hardware store.
		$b
		$n Post up and try to spot your customers, and offer 'em a gram or two.
		$b
		$w but if you see a cop, drop what you're doing (esc key) or you'll lose all your product and it'll go on your record
		$b
		$h once you've got a bit of spare cash you should go see Felix and get a scale and a pager. Eye-balling grams is going cost ya
		$n One last thing
		$b
		$n Don't hang out in one spot too long, cops in this town have got ears everywhere and you'll start seeing a lot more of them
		$b
		$h Good luck man, see you on the corners
	--> "Yeah man I know how to hustle dope" | clear deal_tut
		$h Right on man! See you around
	$r | clear deal_tut



# ============================================================
#  .dlg QUICK REFERENCE   (everything after # is a comment)
# ============================================================
#
# ENTRY KEYS (one block each; pick the matching entry by tags)
#   default            # fallback when nothing else matches (lowest priority)
#   *                  # matches always (priority 0)
#   mon.bodega         # tags joined by '.' — needs BOTH 'mon' AND 'bodega' in context
#   event:intro_scene  # an event block, run by the event director
#
# ENTRY PRECONDITIONS  (after a '|', separated by ';' — ALL must pass)
#   mon.bodega | has_pager ; !has_job          # flag set ; flag NOT set
#   * | trust >= 50                            # compare a stat (ops: >= <= == != > <)
#   * | event_done met_hank ; has_item slim_jim
#
# BODY (indented under the key; tabs or spaces, must be deeper than key)
#   $h Hey there.          # $<code> = portrait/speaker code, rest = text
#   And welcome.           # continuation line (appends to previous text)
#   $b                     # page break (next text is a new box)
#
# QUESTIONS / CHOICES
#   $q                                         # start a choice block
#     --> "Sure thing." | set global:has_job   # response | clauses
#     --> "Not now." | trust < 20              # response shown only if clause passes
#       $h Suit yourself.                      # indented = follow-up after picking
#   $r                                         # END the question block (required!)
#
# RESPONSE CLAUSES  (after '|', ';'-separated — preconditions AND effects mix freely)
#   EFFECTS:   set NAME      # set flag true   (NPC-local unless 'global:' prefix)
#              clear NAME     # set flag false
#              set global:has_job   # GLOBAL flag (autoloads listen to these!)
#              trust +5       # stat delta (trust / affinity), +N or -N
#              affinity -2
#   PRECONDS:  same forms as entry preconditions (flags, compare, has_item, event_done)
# ============================================================